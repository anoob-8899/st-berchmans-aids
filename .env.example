# PostgreSQL Database Connection URL (e.g. Render / Supabase / Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?sslmode=require"

# JWT Authentication Secret Key
JWT_SECRET="your_production_jwt_secret_key_here"

# Department Administrator Initial Setup Credentials (Seed)
ADMIN_INITIAL_USERNAME="adminaids"
ADMIN_INITIAL_PASSWORD="your_secure_initial_admin_password_here"

# Cloudinary Persistent File Storage Credentials
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Gemini AI Engine Credentials & Model Selection
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# Node Environment ("development" | "production")
NODE_ENV="production"
